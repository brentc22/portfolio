---
import { layers } from '../data/site.js'
---

<section class="layers" aria-label="What a platform like this covers">
  <div class="shell">
    <ul class="grid">
      {
        layers.map((layer, i) => (
          <li class="reveal" style={`--i: ${i}`}>
            <span class="tick" style={`background: var(--${layer.key})`} />
            <h2>{layer.name}</h2>
            <ul class="modules">
              {layer.modules.map((module) => <li>{module}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .layers {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--bg-sunk);
    border-block: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    /* The gutter is painted too, so the rules run edge to edge. */
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: 0;
  }

  .grid > li {
    background: var(--bg-sunk);
    padding: 1.4rem var(--gutter) 1.7rem;
  }

  .grid > li:not(:first-child) { padding-inline-start: 1.5rem; }
  .grid > li:not(:last-child) { padding-inline-end: 1.5rem; }

  .tick { display: block; width: 34px; height: 5px; }

  h2 {
    margin-top: 0.85rem;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .modules {
    margin-top: 0.6rem;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    line-height: 2;
    color: var(--ink-4);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid > li:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 520px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .grid > li:last-child { grid-column: auto; }
  }
</style>
