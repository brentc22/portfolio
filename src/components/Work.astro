---
import { projects, layers } from '../data/site.js'
import CasePreview from './CasePreview.astro'
---

<section class="work" id="work">
  <div class="shell">
    <header class="section-head reveal">
      <span class="spectrum dots" aria-hidden="true">
        {layers.slice(0, 4).map((layer) => <span style={`background: var(--${layer.key})`}></span>)}
      </span>
      <h2 class="mono">Selected work</h2>
      <p class="mono note">four systems, not a gallery</p>
    </header>

    <ul class="cases">
      {
        projects.map((project, i) => (
          <li class="reveal" style={`--i: ${i % 2}`}>
            <a
              class="case"
              href={project.href}
              style={`--c: var(--${project.layer})`}
              {...(project.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="case-rule" />
              <CasePreview kind={project.preview} layer={project.layer} />
              <span class="preview-label mono">{project.previewLabel}</span>

              <span class="case-body">
                <span class="case-meta">
                  <span class="mono num">{project.number}</span>
                  <span class={`badge ${project.badge.solid ? 'badge-solid' : ''}`}>
                    {project.badge.label}
                  </span>
                  <span class="arrow" aria-hidden="true">{project.external ? '↗' : '→'}</span>
                </span>
                <span class="case-name">{project.name}</span>
                <span class="case-summary">{project.summary}</span>
                <span class="tags">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work { padding-block: clamp(3.5rem, 7vw, 5.5rem) 0; }

  .section-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.6rem;
  }

  .dots span { width: 10px; height: 10px; }

  .section-head h2 { font-size: 0.72rem; font-weight: 500; color: var(--ink-2); }
  .note { margin-left: auto; font-size: 0.72rem; text-transform: none; letter-spacing: 0.04em; }

  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .case {
    position: relative;
    display: block;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease),
      border-color 0.22s var(--ease);
  }

  .case:hover,
  .case:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 var(--c);
    border-color: var(--c);
  }

  .case:hover .case-name,
  .case:focus-visible .case-name { color: var(--c); }

  .case:hover .arrow,
  .case:focus-visible .arrow { transform: translate(5px, -5px); color: var(--c); }

  .case-rule { display: block; height: 6px; background: var(--c); }

  .preview-label {
    display: block;
    padding: 0.7rem 1.4rem 0;
    font-size: 0.6rem;
    color: var(--ink-5);
  }

  .case-body { display: block; padding: 0.7rem 1.4rem 1.5rem; }

  .case-meta { display: flex; align-items: center; gap: 0.85rem; }
  .num { font-size: 0.72rem; color: var(--c); letter-spacing: 0.1em; }

  .badge {
    padding: 0.24rem 0.56rem;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }
  .badge-solid { background: var(--c); color: var(--bg); border-color: transparent; }

  .arrow {
    margin-left: auto;
    font-size: 1.45rem;
    line-height: 1;
    color: var(--ink-5);
    transition: transform 0.3s var(--ease), color 0.25s var(--ease);
  }

  .case-name {
    display: block;
    margin-top: 0.7rem;
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.032em;
    transition: color 0.25s var(--ease);
  }

  .case-summary {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink-3);
  }

  .tags { display: flex; flex-wrap: wrap; gap: 1px; margin-top: 1.1rem; }
  .tags .tag {
    padding: 0.36rem 0.68rem;
    font-family: 'Azeret Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
  }

  @media (max-width: 900px) {
    .cases { grid-template-columns: minmax(0, 1fr); }
    .note { display: none; }
  }
</style>
