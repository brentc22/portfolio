---
import { getSite, defaultLang } from '../i18n'
import SectionHead from './SectionHead.astro'

const { lang = defaultLang } = Astro.props
const t = getSite(lang)
---

<section class="approach" id="approach">
  <div class="shell">
    <SectionHead
      eyebrow={t.ui.approach.eyebrow}
      title={t.ui.approach.title}
      aside={t.ui.approach.aside}
      colour="invoices"
      id="approach-title"
    />

    <ol class="rules">
      {
        t.principles.map((rule, i) => (
          <li class="reveal" style={`--c: var(--${rule.layer}); --i: ${i % 2}`}>
            <span class="index mono" aria-hidden="true">{rule.number}</span>

            <div class="rule-body">
              <h3>{rule.title}</h3>
              <p class="body">{rule.body}</p>

              <dl class="detail">
                <div class="detail-row">
                  <dt class="mono">{t.ui.approach.practice}</dt>
                  <dd>{rule.practice}</dd>
                </div>
                <div class="detail-row cost">
                  <dt class="mono">{t.ui.approach.cost}</dt>
                  <dd>{rule.cost}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .approach { padding-block: clamp(3.5rem, 7vw, 5.5rem) 0; }

  .rules { counter-reset: none; }

  .rules > li {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0 2rem;
    padding: 2.2rem 0 2.4rem 1.6rem;
    border-top: 1px solid var(--line);
  }
  .rules > li:last-child { border-bottom: 1px solid var(--line); }

  /* The layer colour is a hairline until the rule is under the cursor. */
  .rules > li::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 5px;
    background: var(--c);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.4s var(--ease);
  }
  .rules > li:hover::before { transform: scaleY(1); }

  .index {
    font-size: 2.1rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    color: var(--c);
    opacity: 0.55;
    transition: opacity 0.3s var(--ease);
  }
  .rules > li:hover .index { opacity: 1; }

  h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.032em;
    line-height: 1.18;
    max-width: 26ch;
    text-wrap: balance;
  }

  .body {
    margin-top: 0.85rem;
    max-width: 62ch;
    font-size: 1.02rem;
    line-height: 1.66;
    color: var(--ink-3);
  }

  .detail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .detail-row { background: var(--bg); padding: 0.95rem 1.1rem 1.05rem; }

  dt {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--c);
  }
  .cost dt { color: var(--ink-5); }

  dd {
    margin: 0.5rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .cost dd { color: var(--ink-4); }

  @media (max-width: 860px) {
    .rules > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
      padding-left: 1.2rem;
    }
    .index { font-size: 1.4rem; }
    .detail { grid-template-columns: minmax(0, 1fr); }
  }
</style>
