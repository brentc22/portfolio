---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import { getSite, dictionaries, defaultLang, localePath } from '../i18n'

const lang = defaultLang
const t = getSite(lang)

/** A static host serves one 404.html for every unknown path, so this page
 *  cannot know its language at build time. It renders in the default
 *  language and carries the other two with it, to be swapped in the browser
 *  from the path (/nl/…) or the visitor's own language setting. */
const strings = Object.fromEntries(
  Object.entries(dictionaries).map(([code, d]) => [
    code,
    { ...d.ui.notFound, homeHref: localePath('/', code), workHref: `${localePath('/', code)}#work` },
  ]),
)
---

<Layout lang={lang} page="notFound">
  <Header lang={lang} />

  <main id="main" class="notfound">
    <div class="shell">
      <p class="mono code rise">404</p>
      <h1 class="rise" style="animation-delay: 0.08s" data-nf="title">{t.ui.notFound.title}</h1>

      <div class="spectrum rule rise" style="animation-delay: 0.16s">
        {
          t.layers.map((layer, i) => (
            <span style={`background: var(--${layer.key}); animation-delay: ${0.3 + i * 0.09}s`} />
          ))
        }
      </div>

      <p class="lead rise" style="animation-delay: 0.24s" data-nf="body">{t.ui.notFound.body}</p>

      <div class="actions rise" style="animation-delay: 0.32s">
        <a class="btn btn-solid" href="/" data-nf="home">{t.ui.notFound.home}</a>
        <a class="btn btn-ghost" href="/#work" data-nf="work">{t.ui.notFound.work}</a>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ strings, defaultLang }}>
    const fromPath = location.pathname.split('/')[1]
    const fromBrowser = (navigator.language || '').slice(0, 2).toLowerCase()
    const lang = strings[fromPath] ? fromPath : strings[fromBrowser] ? fromBrowser : defaultLang
    if (lang !== defaultLang) {
      const s = strings[lang]
      document.documentElement.lang = lang
      document.querySelector('[data-nf="title"]').textContent = s.title
      document.querySelector('[data-nf="body"]').textContent = s.body
      const home = document.querySelector('[data-nf="home"]')
      home.textContent = s.home
      home.href = s.homeHref
      const work = document.querySelector('[data-nf="work"]')
      work.textContent = s.work
      work.href = s.workHref
    }
  </script>
</Layout>

<style>
  .notfound { padding-block: clamp(3.5rem, 9vw, 7rem) clamp(4rem, 10vw, 8rem); }

  .code { font-size: 0.72rem; letter-spacing: 0.2em; color: var(--portal); }

  h1 {
    margin-top: 1rem;
    max-width: 16ch;
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .rule { height: 12px; max-width: 30rem; margin-top: 2rem; }
  .rule span { flex: 1; transform-origin: left; animation: grow 0.55s var(--ease) both; }

  .lead {
    margin-top: 2rem;
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.66;
    color: var(--ink-3);
  }

  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.4rem; }
</style>
